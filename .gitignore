# ============================================
# ServUO .gitignore
# Goal: run out of the box, except accounts.xml
# ============================================

# ---- Account Files (excluded) ----
accounts.xml
accounts/*.xml

# ---- Build Artifacts ----
# These are regenerated by compiling, so no need to track them.
/Ultima.dll
/Ultima.pdb
/Ultima.dll.mdb
/Ultima/bin/
/Ultima/obj/
/Server/bin/
/Server/obj/
/Scripts/bin/
/Scripts/obj/
/Scripts/Output/

# ---- Logs (excluded) ----
/Logs/
*.log

# ---- Backups (excluded) ----
/Backups/

# ---- IDE / Editor ----
/.vs/
*.suo
*.csproj.user
*.DotSettings.user
.vscode/
.idea/

# ---- OS Files ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- Optional: local-only config ----
/firewall.cfg
/staffHistory.xml
/reportHistory.xml

# ---- Broad patterns for safety ----
*.pdb
*.exe
*.exe.mdb
*.bin
*.tmp
*.bak

# ---- IMPORTANT: Keep these tracked ----
!/Data/*
!/Saves/
!/Web/
!/Docs/
!/Reports/
!/Honesty/
!/drng64.dll
!/drng32.dll
!/libdrng.so